{
  "name": "lanxiaomei-desktop-pet",
  "version": "2.0.0",
  "description": "蓝小妹桌宠：面向蓝世_1967粉丝的开源桌面互动小伙伴。",
  "productName": "蓝小妹桌宠",
  "homepage": "https://github.com/K1Ta-Ynni/lanxiaomei-desktop-pet",
  "repository": {
    "type": "git",
    "url": "https://github.com/K1Ta-Ynni/lanxiaomei-desktop-pet.git"
  },
  "bugs": {
    "url": "https://github.com/K1Ta-Ynni/lanxiaomei-desktop-pet/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:desktop": "node scripts/smoke.mjs",
    "test:companion": "node scripts/smoke-companion.mjs",
    "test:settings": "node scripts/smoke-settings.mjs",
    "test:dpi": "node scripts/smoke-dpi.mjs",
    "test:music": "node scripts/smoke-music.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "package:basic": "node scripts/package-windows.mjs --edition=basic",
    "package:companion": "node scripts/package-windows.mjs --edition=companion",
    "test:package": "node scripts/smoke-package.mjs",
    "test:updates": "node --test test/updates.test.js",
    "test:updater": "node scripts/smoke-updater.mjs"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "playwright": "^1.64.1",
    "rcedit": "^5.0.2"
  }
}
